# Pre-built amd64 image for molecule debian12 scenario.
# Built manually via scripts/build-molecule-amd64-images.sh on arm64 hosts
# (Apple Silicon) because MongoDB 8.0 ships only amd64 server packages for
# Debian bookworm. CI on amd64 Linux runners uses the regular Dockerfile.j2
# (this file is local-dev workaround only).
#
# Build:
#   docker buildx build --platform linux/amd64 --load \
#     -t local/molecule-debian12-amd64:bookworm \
#     -f Dockerfile.amd64 .
FROM debian:12

ENV container=docker
RUN apt-get update && apt-get install -y --no-install-recommends \
    systemd systemd-sysv \
    python3 python3-pip python3-apt \
    sudo curl gnupg ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /lib/systemd/system/multi-user.target.wants/* \
            /etc/systemd/system/*.wants/* \
            /lib/systemd/system/local-fs.target.wants/* \
            /lib/systemd/system/sockets.target.wants/*udev* \
            /lib/systemd/system/sockets.target.wants/*initctl* \
            /lib/systemd/system/basic.target.wants/* \
            /lib/systemd/system/anaconda.target.wants/*

VOLUME ["/sys/fs/cgroup", "/run", "/run/lock", "/tmp"]
STOPSIGNAL SIGRTMIN+3
CMD ["/lib/systemd/systemd"]
