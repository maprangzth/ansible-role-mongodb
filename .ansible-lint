skip_list:
  - fqcn-builtins
  - ignore-errors
  - command-instead-of-module
  - no-changed-when
  - risky-file-permissions
  - command-instead-of-shell
  - experimental
  - var-naming[pattern]   # camelCase vars mirror MongoDB config keys (intentional v2 design)
  - yaml[line-length]     # long exporter download URL template is unavoidable